{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/benchmarks/long-context/schemas/repository.schema.json",
  "title": "Long-Context Benchmark Repository",
  "description": "Metadata describing a benchmark repository and its optional task directories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "repositoryId",
    "title",
    "description",
    "source",
    "languages",
    "tasks",
    "stats"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "repositoryId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "fixtureRoot": {
      "$ref": "#/$defs/relativePath"
    },
    "defaultBranch": {
      "type": "string",
      "default": "main"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["synthetic", "sanitized", "git", "archive", "local-fixture"]
        },
        "createdAt": {
          "type": "string",
          "format": "date"
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "archiveFile": {
          "$ref": "#/$defs/relativePath"
        },
        "pinnedCommit": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "extractionJustification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approxFileCount", "approxTokenCount", "entrypointFiles"],
      "properties": {
        "approxFileCount": {
          "type": "integer",
          "minimum": 1
        },
        "approxTokenCount": {
          "type": "integer",
          "minimum": 1
        },
        "entrypointFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "setupCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationCommand"
          }
        },
        "resetCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationCommand"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskRef"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(\\./|\\.\\./).+"
    },
    "taskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "taskDirectory"],
      "properties": {
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "taskDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "validationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "workingDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "description": {
          "type": "string"
        },
        "expectExitCode": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
